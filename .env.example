# Environment Variables Template for HH Goa 2026 Task 3 Project
# Copy this file to .env and fill in your actual credentials.

# SerpApi API Key for Google Lens Reverse Image Search
SERPAPI_KEY=your_serpapi_key_here

# Local Blockchain RPC Endpoint (Ganache / Anvil)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Optional: Local Private Key (Leave blank if local node uses unlocked accounts)
BLOCKCHAIN_PRIVATE_KEY=
